# Copy to .env and fill in. Never commit .env.

# --- Required: at least one LLM key (via LiteLLM). Primary: Groq; fallback: Gemini. ---
# Groq (free): https://console.groq.com/keys    Gemini (free): https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
# LLM_MODEL=groq/openai/gpt-oss-20b
# LLM_FALLBACK_MODEL=gemini/gemini-3.8-flash

# --- Optional ---

# Signs login tokens. Leave empty to get a random one at each start (users then log in again).
# Generate a stable one: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Demo admin, created on first start if it does not exist. Sign-up (@moveo.co.il only) creates analysts.
# DEMO_ADMIN_EMAIL=admin@moveo.co.il
# DEMO_ADMIN_PASSWORD=12345678

# Sent in the User-Agent to the public data APIs
# CONTACT_EMAIL=you@example.com

# Score-change alerts: each user sets their own webhook URL, on/off and threshold on the Alerts page.
# ALERT_THRESHOLD=5               # default threshold (points on the 0–100 overall score)
# ALERT_CHECK_HOURS=24
# SCHEDULER_ENABLED=true
# ALERT_TRIGGER_SECRET=           # lets an external cron call POST /alerts/run with header X-Alert-Secret

# Voice input (needs GROQ_API_KEY)
# TRANSCRIBE_MODEL=groq/whisper-large-v3-turbo

# Storage (SQLite file; its folder is created on first start)
# DATABASE_URL=sqlite+aiosqlite:///data/app.db

# UI → API (set automatically by scripts/run.py and docker-compose.yml)
# API_URL=http://localhost:8000
