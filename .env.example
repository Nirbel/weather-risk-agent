# Copy to .env and fill in. Never commit .env.

# LLM (via LiteLLM). Primary: Groq; fallback: Gemini.
GROQ_API_KEY=
GEMINI_API_KEY=
# LLM_MODEL=groq/openai/gpt-oss-20b
# LLM_FALLBACK_MODEL=gemini/gemini-3.8-flash

# Sent in the User-Agent to the public data APIs
CONTACT_EMAIL=you@example.com

# Auth: allow-listed emails with roles (analyst | admin); change the secret
AUTH_ALLOWLIST=analyst@example.com:analyst,admin@example.com:admin
JWT_SECRET=change-me  # generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Score-change alerts (optional; an admin can also set URL, on/off and threshold in the UI)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_THRESHOLD=5
# ALERT_CHECK_HOURS=24
# SCHEDULER_ENABLED=true
# ALERT_TRIGGER_SECRET=change-me   # lets an external cron call POST /alerts/run

# Voice input (needs GROQ_API_KEY)
# TRANSCRIBE_MODEL=groq/whisper-large-v3-turbo

# UI → API
# API_URL=http://localhost:8000
